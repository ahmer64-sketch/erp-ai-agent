# Required
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: each one switches on one model in the pipeline
COHERE_API_KEY=        # rerank for catalogue search
GROQ_API_KEY=          # fast intent router
GOOGLE_API_KEY=        # Gemini Flash bulk analyst

# Optional: query a Databricks copy of the ERP data (falls back to local files)
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# Optional: real data locations (default: ./cleaned_erp_data.xlsx and ./reman, else sample_data/)
ERP_DATA_FILE=
MARG_DATA_DIR=

# Optional: app login
APP_USERNAME=
APP_PASSWORD=

# Optional: daily alert (daily_alert.py)
ALERT_FROM_EMAIL=
ALERT_EMAIL_PASS=
ALERT_TO_EMAIL=
ALERT_TIME=08:00
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
